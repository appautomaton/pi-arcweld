#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ "$(uname -s)" = Linux ] && { grep -qi 'PRoot' /proc/version 2>/dev/null || uname -a | grep -qi 'PRoot'; }; then
  exec "$ROOT/bin/camoufox-mcp-proot" "$@"
fi

# Pin the major, not the patch: take the newest installed nvm Node 24 so routine
# upgrades never strand the launcher; fall back to PATH if none is installed.
NODE=$(ls -d "$HOME"/.nvm/versions/node/v24.*/bin/node 2>/dev/null | sort -V | tail -n 1)
: "${NODE:=node}"

export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

exec "$NODE" "$ROOT/src/index.js" "$@"
