#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ "$(uname -s)" = Linux ] && { grep -qi 'PRoot' /proc/version 2>/dev/null || uname -a | grep -qi 'PRoot'; }; then
  exec "$ROOT/bin/camoufox-mcp-proot" "$@"
fi

# Pin the major, not the patch: resolve XDG nvm Node 24 (`current` or newest v24.*),
# falling back to legacy ~/.nvm and finally PATH if none is installed.
NVM_BASE="${NVM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/nvm}"
NODE="$NVM_BASE/current/bin/node"
if [ ! -x "$NODE" ]; then
  NODE=$(ls -d "$NVM_BASE"/versions/node/v24.*/bin/node "$HOME"/.nvm/versions/node/v24.*/bin/node 2>/dev/null | sort -V | tail -n 1 || true)
fi
: "${NODE:=node}"

export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

exec "$NODE" "$ROOT/src/index.js" "$@"
